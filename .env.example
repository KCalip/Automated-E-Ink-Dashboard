# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and will NEVER be committed - `.env.example` (this file) is safe to commit
# because it contains no real secrets, just the variable names.

SWITCHBOT_TOKEN=your_token_here
SWITCHBOT_SECRET=your_secret_here
SWITCHBOT_DEVICE_ID=your_device_id_here

# Public https URL where output/dashboard.png can be fetched by SwitchBot's
# servers. The upload command is URL-based, not a direct file upload.
# Give the BASE url only - push_to_frame.py appends its own cache-busting
# timestamp (?t=...) automatically before sending it to SwitchBot.
# Example (once the repo commits output/dashboard.png on a schedule):
# https://raw.githubusercontent.com/<you>/<repo>/main/output/dashboard.png
DASHBOARD_IMAGE_URL=your_public_image_url_here
